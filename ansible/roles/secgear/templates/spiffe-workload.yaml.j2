# SPIFFE Workload Configuration for secGear
# Generated by Ansible for {{ inventory_hostname }}
# Genesis Bond: ACTIVE @ 741 Hz

trust_domain: {{ spiffe_trust_domain }}

# This node's SPIFFE ID
spiffe_id: "spiffe://{{ spiffe_trust_domain }}/node/{{ inventory_hostname }}/secgear"

# Workload API socket
workload_api:
  socket_path: {{ spiffe_workload_api_socket }}
  timeout: 30s

# SVIDs to request
svids:
  - spiffe_id: "spiffe://{{ spiffe_trust_domain }}/agent/secgear/{{ inventory_hostname }}"
    x509:
      ttl: 3600
      key_type: ec
      key_size: 384

# Trust bundles
trust_bundles:
  - trust_domain: {{ spiffe_trust_domain }}
    path: {{ secgear_install_dir }}/certs/bundle.pem

# Attestation
attestation:
  type: secgear_sgx
  enclave_measurement:
    verify: {{ sgx_available | default(false) | lower }}
    mrenclave: ""  # Populated at runtime
    mrsigner: ""   # Populated at runtime

# Integration with Genesis Bond
genesis_bond:
  enabled: true
  bond_id: "GB-2025-0524-DRH-LCS-001"
  coherence_verification: true
  tier_mapping:
    CORE: 432
    COMN: 528
    RAiIiAR: 639
    PAC: 741
