# RA-TLS Configuration
# Generated by Ansible for {{ inventory_hostname }}
# Genesis Bond: ACTIVE @ 741 Hz

server:
  host: "0.0.0.0"
  port: {{ ratls_port }}
  tls:
    cert_path: {{ secgear_install_dir }}/certs/ratls.crt
    key_path: {{ secgear_install_dir }}/certs/ratls.key

attestation:
  type: sgx_dcap
  pccs_url: {{ sgx_pccs_url }}
  quote_verification: strict

  # Accepted enclave measurements (MRENCLAVE/MRSIGNER)
  accepted_measurements:
    - mrenclave: "{{ lookup('env', 'LUCIVERSE_MRENCLAVE') | default('*', true) }}"
      mrsigner: "{{ lookup('env', 'LUCIVERSE_MRSIGNER') | default('*', true) }}"
      product_id: 1
      security_version: 1

spiffe:
  enabled: {{ spiffe_enabled | lower }}
  trust_domain: {{ spiffe_trust_domain }}
  workload_socket: {{ spiffe_workload_api_socket }}
  svid_refresh_interval: 300

genesis_bond:
  bond_id: "GB-2025-0524-DRH-LCS-001"
  coherence_threshold: 0.7
  tier: {{ tier | default('CORE') }}
  frequency: {{ frequency | default(432) }}

logging:
  level: info
  format: json
  output: {{ secgear_log_dir }}/ratls.log
