# openYuanrong Executor Configuration
# Generated by Ansible for {{ inventory_hostname }}
# Genesis Bond: ACTIVE @ 741 Hz

server:
  host: "0.0.0.0"
  port: {{ openyuanrong_executor_port }}

cluster:
  name: {{ openyuanrong_cluster_name }}
  scheduler_address: {{ openyuanrong_scheduler_address }}
  node_id: "{{ inventory_hostname }}"

executor:
  concurrent_limit: {{ openyuanrong_function_concurrent_limit }}
  timeout: {{ openyuanrong_function_timeout }}
  memory_limit: "{{ openyuanrong_function_memory_limit }}"

  # Function storage
  function_dir: {{ openyuanrong_function_dir }}
  data_dir: {{ openyuanrong_data_dir }}

  # Runtime support
  runtimes:
{% for runtime in openyuanrong_runtimes %}
    - name: {{ runtime }}
      enabled: true
{% endfor %}

  # Isolation backend
  isolation:
{% if openyuanrong_stratovirt_enabled %}
    type: stratovirt
    config:
      socket_dir: /run/stratovirt/sockets
      hugepages: true
{% else %}
    type: containerd
    config:
      socket: /run/containerd/containerd.sock
      namespace: luciverse-functions
{% endif %}

# Genesis Bond integration
genesis_bond:
  bond_id: "GB-2025-0524-DRH-LCS-001"
  tier: "{{ tier | default('COMN') }}"
  frequency: {{ frequency | default(528) }}
  coherence_threshold: 0.7

# Logging
logging:
  level: info
  format: json
  output: {{ openyuanrong_log_dir }}/executor.log

# Metrics
metrics:
  enabled: true
  port: {{ openyuanrong_executor_port | int + 100 }}
  path: /metrics
