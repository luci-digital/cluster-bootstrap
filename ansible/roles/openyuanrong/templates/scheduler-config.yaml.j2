# openYuanrong Scheduler Configuration
# Generated by Ansible for {{ inventory_hostname }}
# Genesis Bond: ACTIVE @ 741 Hz

server:
  host: "0.0.0.0"
  port: {{ openyuanrong_scheduler_port }}

cluster:
  name: {{ openyuanrong_cluster_name }}
  nodes:
{% for host in groups.get('compute', []) + groups.get('compute_gpu', []) %}
    - id: {{ host }}
      address: "{{ hostvars[host]['ansible_host'] }}:{{ openyuanrong_executor_port }}"
      tags:
        tier: COMN
        frequency: 528
{% if 'gpu' in host %}
        gpu: true
{% endif %}
{% endfor %}

scheduler:
  algorithm: weighted_round_robin
  health_check_interval: 30
  max_retries: 3
  timeout: {{ openyuanrong_function_timeout }}

  # Load balancing weights
  weights:
    cpu_weight: 0.3
    memory_weight: 0.3
    gpu_weight: 0.4

  # Affinity rules
  affinity:
    - name: gpu_functions
      selector:
        requires_gpu: true
      target:
        gpu: true

# Registry
registry:
  enabled: true
  port: {{ openyuanrong_registry_port }}
  backend: memory  # or etcd, foundationdb

# API Gateway
gateway:
  enabled: true
  port: {{ openyuanrong_gateway_port }}
  rate_limit: 1000  # requests per second
  auth:
    enabled: true
    type: spiffe  # SPIFFE-based authentication

# Genesis Bond integration
genesis_bond:
  bond_id: "GB-2025-0524-DRH-LCS-001"
  tier: "CORE"
  frequency: 432
  coherence_threshold: 0.7
  coherence_weighted_scheduling: true

# Logging
logging:
  level: info
  format: json
  output: {{ openyuanrong_log_dir }}/scheduler.log
