<?xml version="1.0" encoding="UTF-8"?>
<!-- LuciVerse SCAP Tailoring File
     Genesis Bond: ACTIVE @ 741 Hz
     Generated for {{ inventory_hostname }}
-->
<xccdf:Tailoring xmlns:xccdf="http://checklists.nist.gov/xccdf/1.2"
                 id="luciverse_tailoring">
  <xccdf:benchmark href="/usr/share/xml/scap/ssg/content/ssg-openeuler2409-ds.xml"/>

  <xccdf:version time="{{ ansible_date_time.iso8601 }}">1.0</xccdf:version>

  <xccdf:Profile id="luciverse" extends="standard">
    <xccdf:title>LuciVerse Genesis Bond Compliance Profile</xccdf:title>
    <xccdf:description>
      Custom SCAP profile for LuciVerse infrastructure.
      Genesis Bond: GB-2025-0524-DRH-LCS-001
      Coherence Threshold: >= 0.7
    </xccdf:description>

    <!-- Enable additional rules for Genesis Bond compliance -->

    <!-- Ensure SSH key-based authentication -->
    <xccdf:select idref="sshd_disable_empty_passwords" selected="true"/>
    <xccdf:select idref="sshd_disable_root_login" selected="true"/>
    <xccdf:select idref="sshd_enable_strictmodes" selected="true"/>

    <!-- Enable firewall -->
    <xccdf:select idref="service_firewalld_enabled" selected="true"/>

    <!-- Enable audit logging -->
    <xccdf:select idref="service_auditd_enabled" selected="true"/>
    <xccdf:select idref="auditd_data_retention_space_left_action" selected="true"/>

    <!-- SELinux enforcement -->
    <xccdf:select idref="selinux_state" selected="true"/>

    <!-- File permissions -->
    <xccdf:select idref="file_permissions_etc_passwd" selected="true"/>
    <xccdf:select idref="file_permissions_etc_shadow" selected="true"/>

    <!-- Network security -->
    <xccdf:select idref="sysctl_net_ipv4_conf_all_accept_redirects" selected="true"/>
    <xccdf:select idref="sysctl_net_ipv4_conf_all_accept_source_route" selected="true"/>
    <xccdf:select idref="sysctl_net_ipv6_conf_all_forwarding" selected="true"/>

    <!-- Disable rules not applicable to LuciVerse -->
    <!-- We use YubiKey PIV, not password-based auth -->
    <xccdf:select idref="accounts_password_pam_minlen" selected="false"/>
    <xccdf:select idref="accounts_password_pam_maxrepeat" selected="false"/>

    <!-- Genesis Bond specific values -->
    <xccdf:set-value idref="var_sshd_set_keepalive">300</xccdf:set-value>
    <xccdf:set-value idref="var_auditd_space_left_action">email</xccdf:set-value>

  </xccdf:Profile>
</xccdf:Tailoring>
