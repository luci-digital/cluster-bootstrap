# Ray Cluster Configuration
# Generated by Ansible for {{ inventory_hostname }}
# Genesis Bond: ACTIVE @ 741 Hz

cluster_name: luciverse-ray-cluster

# Head node configuration
head_node:
  node_ip_address: "{{ hostvars['core-gpu-01']['ansible_host'] | default('192.168.1.143') }}"
  port: {{ ray_head_port }}
  dashboard_port: {{ ray_dashboard_port }}
  dashboard_host: "0.0.0.0"
  object_store_memory: {{ ray_object_store_memory }}

# Worker configuration
worker_nodes:
{% for host in groups.get('compute_gpu', []) %}
  - node_ip_address: "{{ hostvars[host]['ansible_host'] }}"
    resources:
      GPU: 1
      CPU: 8
      memory: 32000000000
{% endfor %}

# Runtime environment
runtime_env:
  pip:
    - vllm
    - torch
    - transformers
    - accelerate
  env_vars:
    CUDA_VISIBLE_DEVICES: "0"
    HF_HOME: "{{ intelligence_boom_model_cache }}"

# Autoscaling
autoscaler_config:
  max_workers: 4
  idle_timeout_minutes: 5

# Logging
logging_level: INFO
log_to_driver: true
