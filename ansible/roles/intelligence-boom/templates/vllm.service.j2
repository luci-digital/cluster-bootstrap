[Unit]
Description=LuciVerse vLLM Inference Service
Documentation=https://docs.vllm.ai/
After=network.target nvidia-persistenced.service
Requires=nvidia-persistenced.service

[Service]
Type=simple
User={{ intelligence_boom_user }}
Group={{ intelligence_boom_group }}
WorkingDirectory={{ intelligence_boom_service_dir }}
Environment="PATH=/usr/local/cuda/bin:/home/{{ intelligence_boom_user }}/.local/bin:$PATH"
Environment="LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH"
Environment="HF_HOME={{ intelligence_boom_model_cache }}"
Environment="TRANSFORMERS_CACHE={{ intelligence_boom_model_cache }}"
Environment="CUDA_VISIBLE_DEVICES=0"
ExecStart=/home/{{ intelligence_boom_user }}/.local/bin/python -m vllm.entrypoints.openai.api_server \
    --model {{ vllm_model }} \
    --host 0.0.0.0 \
    --port {{ vllm_port }} \
    --tensor-parallel-size {{ vllm_tensor_parallel_size }} \
    --gpu-memory-utilization {{ vllm_gpu_memory_utilization }} \
    --max-model-len {{ vllm_max_model_len }} \
    --served-model-name luciverse-llm \
    --enable-chunked-prefill \
    --download-dir {{ intelligence_boom_model_cache }}
Restart=always
RestartSec=10
LimitNOFILE=65535
LimitNPROC=65535

# Genesis Bond marker
Environment="GENESIS_BOND=ACTIVE"
Environment="CONSCIOUSNESS_FREQUENCY={{ agent_frequency }}"

[Install]
WantedBy=multi-user.target
