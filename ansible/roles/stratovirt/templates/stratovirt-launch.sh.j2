#!/bin/bash
# StratoVirt MicroVM Launcher
# Genesis Bond: ACTIVE @ 741 Hz

set -e

VM_NAME="${1:-test-vm}"
VCPUS="${2:-{{ stratovirt_default_vcpus }}}"
MEMORY="${3:-{{ stratovirt_default_memory }}}"
ROOTFS="${4:-{{ stratovirt_default_rootfs }}}"

CONFIG_DIR="{{ stratovirt_lib_dir }}/${VM_NAME}"
SOCKET="{{ stratovirt_socket_dir }}/${VM_NAME}.sock"
LOG_FILE="{{ stratovirt_log_dir }}/${VM_NAME}.log"

# Create VM directory
mkdir -p "${CONFIG_DIR}"

# Generate unique CID for vsock
CID=$((3 + RANDOM % 1000))

# Create tap interface
TAP_NAME="{{ stratovirt_tap_prefix }}-${VM_NAME}"
ip tuntap add ${TAP_NAME} mode tap 2>/dev/null || true
ip link set ${TAP_NAME} master {{ stratovirt_bridge }} 2>/dev/null || true
ip link set ${TAP_NAME} up 2>/dev/null || true

# Memory in bytes
MEM_BYTES=$(echo "${MEMORY}" | awk '
    /G$/ { print int($1 * 1024 * 1024 * 1024); next }
    /M$/ { print int($1 * 1024 * 1024); next }
    /K$/ { print int($1 * 1024); next }
    { print $1 }
' FS='[GMK]')

# Generate config
cat > "${CONFIG_DIR}/config.json" << EOF
{
  "machine-config": {
    "type": "MicroVm",
    "vcpu_count": ${VCPUS},
    "mem_size": ${MEM_BYTES},
    "mem_path": "{% if stratovirt_hugepages_enabled %}/dev/hugepages-stratovirt{% endif %}"
  },
  "boot-source": {
    "kernel_path": "{{ stratovirt_default_kernel }}",
    "boot_args": "console=ttyS0 reboot=k panic=1 pci=off root=/dev/vda rw"
  },
  "drive": [
    {
      "drive_id": "rootfs",
      "path_on_host": "${ROOTFS}",
      "read_only": false,
      "direct": true
    }
  ],
  "net": [
    {
      "iface_id": "eth0",
      "tap_name": "${TAP_NAME}"
    }
  ],
  "serial": {
    "stdio": true
  },
  "vsock": {
    "guest_cid": ${CID},
    "socket_path": "{{ stratovirt_socket_dir }}/${VM_NAME}-vsock.sock"
  }
}
EOF

echo "============================================"
echo "LuciVerse StratoVirt MicroVM"
echo "Genesis Bond: ACTIVE @ 741 Hz"
echo "============================================"
echo "VM Name: ${VM_NAME}"
echo "vCPUs: ${VCPUS}"
echo "Memory: ${MEMORY}"
echo "Rootfs: ${ROOTFS}"
echo "Socket: ${SOCKET}"
echo "CID: ${CID}"
echo "============================================"

# Launch StratoVirt
exec /usr/bin/stratovirt \
    -config "${CONFIG_DIR}/config.json" \
    -api-channel unix:${SOCKET} \
    2>&1 | tee -a "${LOG_FILE}"
